# .env.example — Plantilla de las variables de entorno que usa este proyecto.
# Copia este archivo como .env y pon los valores reales solo en el servidor.
# Este archivo sí va en Git; el .env con los valores reales, nunca.

# --- Base de datos (scripts/respaldo.sh) ---
# Las tres son obligatorias: respaldo.sh se detiene si falta alguna.

# Servidor de PostgreSQL del que respaldo.sh saca la copia de la base con pg_dump.
DB_HOST=db.ejemplo.invalid

# Usuario de PostgreSQL con el que respaldo.sh se conecta para hacer el respaldo.
DB_USER=usuario_ejemplo

# Contraseña de ese usuario; respaldo.sh se la pasa a pg_dump. Es una credencial.
DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
